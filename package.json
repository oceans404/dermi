{
  "name": "skincare-checker",
  "version": "1.0.0",
  "description": "Pore-clogging ingredient checker API",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build:merge": "tsx scripts/merge.ts",
    "build:dedupe": "tsx scripts/dedupe.ts",
    "build:compile": "tsx scripts/compile.ts",
    "build:index": "npm run build:merge && npm run build:dedupe && npm run build:compile",
    "test": "vitest run"
  },
  "keywords": [],
